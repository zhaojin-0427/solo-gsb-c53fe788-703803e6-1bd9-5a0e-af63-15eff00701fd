# 复制为 .env 后按需修改；.env 会被 docker compose 自动加载
# 网关监听地址/端口（容器内固定监听 8080）
GATEWAY_PORT=8080

# PostgreSQL
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway_change_me
POSTGRES_DB=gateway
POSTGRES_PORT=5432

# SQLAlchemy 异步 DSN，一般无需修改（compose 已注入上述变量）
DATABASE_URL=postgresql+asyncpg://gateway:gateway_change_me@db:5432/gateway

# 确定性 HMAC 令牌化的服务端密钥。生产必须通过密钥管理系统注入，绝不入库、不入日志。
# 不设置时仅允许 ALLOW_INSECURE_DEV_KEY=1 时使用内置开发密钥。
SERVER_HMAC_KEY=
ALLOW_INSECURE_DEV_KEY=0

# 日志级别
LOG_LEVEL=INFO
